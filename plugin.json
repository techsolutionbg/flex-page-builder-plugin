{
  "id": "flex/page-builder",
  "name": "Flex Page Builder",
  "version": "0.1.0",
  "description": "Визуален редактор на съдържанието на страница. Хедърът и футърът идват от лейаута на темата.",
  "minimum_platform_version": "0.1.68",
  "entrypoint": "Flex\\PageBuilder\\PageBuilderPlugin",
  "autoload": {
    "Flex\\PageBuilder\\": "src/"
  },
  "permissions": [
    "admin.ui",
    "events.listen",
    "routes.admin",
    "frontend.assets"
  ],
  "frontend": {
    "scripts": [
      "assets/admin.js",
      "assets/lib/canvas.js",
      "assets/lib/compile.js",
      "assets/lib/editor.js",
      "assets/lib/globals.js",
      "assets/lib/inspector.js",
      "assets/lib/links.js",
      "assets/lib/model.js",
      "assets/lib/paths.js",
      "assets/lib/structure.js"
    ],
    "styles": [
      "assets/builder.css",
      "assets/patterns.css"
    ],
    "public": {
      "styles": [
        "assets/content.css",
        "assets/patterns.css"
      ]
    }
  }
}
